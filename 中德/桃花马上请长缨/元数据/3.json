{"subtitle_tones":[{"id":1,"start":"00:00:00,040","end":"00:00:00,600","speaker":"王琳","text":"陈凡","tone":"冷淡地呼唤","emotion":"轻微","group_id":1,"group_tone":"cold, calling out","group_tone_cn":"冷淡地呼唤"},{"id":2,"start":"00:00:01,280","end":"00:00:02,040","speaker":"王琳","text":"我知道你在","tone":"陈述事实的口吻","emotion":"平淡","group_id":2,"group_tone":"matter-of-fact, slightly dismissive","group_tone_cn":"就事论事，略带敷衍"},{"id":3,"start":"00:00:02,040","end":"00:00:03,160","speaker":"王琳","text":"因为纪念日的事情","tone":"略带解释的口吻","emotion":"轻微","group_id":2,"group_tone":"matter-of-fact, slightly dismissive","group_tone_cn":"就事论事，略带敷衍"},{"id":4,"start":"00:00:03,160","end":"00:00:03,720","speaker":"王琳","text":"而生气","tone":"带有一丝敷衍","emotion":"轻微","group_id":2,"group_tone":"matter-of-fact, slightly dismissive","group_tone_cn":"就事论事，略带敷衍"},{"id":5,"start":"00:00:04,360","end":"00:00:05,080","speaker":"王琳","text":"但我现在真的很饿","tone":"抱怨的语气","emotion":"中等","group_id":3,"group_tone":"impatient and complaining","group_tone_cn":"不耐烦地抱怨"},{"id":6,"start":"00:00:05,080","end":"00:00:06,040","speaker":"王琳","text":"你能不能别闹了","tone":"不耐烦的责备","emotion":"强烈","group_id":3,"group_tone":"impatient and complaining","group_tone_cn":"不耐烦地抱怨"},{"id":7,"start":"00:00:07,160","end":"00:00:08,040","speaker":"陈凡","text":"我没有生气","tone":"平静且略显疲惫","emotion":"轻微","group_id":4,"group_tone":"calm and weary denial","group_tone_cn":"平静而疲惫地否认"},{"id":8,"start":"00:00:09,280","end":"00:00:10,320","speaker":"王琳","text":"赵斌失恋了","tone":"理直气壮的陈述","emotion":"中等","group_id":5,"group_tone":"sympathetic yet matter-of-fact","group_tone_cn":"同情但就事论事"},{"id":9,"start":"00:00:10,840","end":"00:00:12,360","speaker":"王琳","text":"他一个人在这座城市","tone":"带有一丝怜悯","emotion":"中等","group_id":5,"group_tone":"sympathetic yet matter-of-fact","group_tone_cn":"同情但就事论事"},{"id":10,"start":"00:00:12,360","end":"00:00:13,080","speaker":"王琳","text":"孤零零的","tone":"强调对方的境遇","emotion":"中等","group_id":5,"group_tone":"sympathetic yet matter-of-fact","group_tone_cn":"同情但就事论事"},{"id":11,"start":"00:00:13,600","end":"00:00:14,400","speaker":"王琳","text":"我不管作为朋友","tone":"强调自己的立场","emotion":"中等","group_id":6,"group_tone":"assertive and unwavering","group_tone_cn":"坚定而不容置疑"},{"id":12,"start":"00:00:14,400","end":"00:00:15,040","speaker":"王琳","text":"还是前任","tone":"坦率到近乎挑衅","emotion":"中等","group_id":6,"group_tone":"assertive and unwavering","group_tone_cn":"坚定而不容置疑"},{"id":13,"start":"00:00:15,440","end":"00:00:16,320","speaker":"王琳","text":"我都应该陪他","tone":"不容置疑的口吻","emotion":"中等","group_id":6,"group_tone":"assertive and unwavering","group_tone_cn":"坚定而不容置疑"},{"id":14,"start":"00:00:17,960","end":"00:00:18,520","speaker":"陈凡","text":"我知道","tone":"平淡且无力的回应","emotion":"轻微","group_id":7,"group_tone":"weak and resigned","group_tone_cn":"软弱而无奈"},{"id":15,"start":"00:00:19,440","end":"00:00:20,520","speaker":"王琳","text":"陈凡你够了","tone":"厌烦的怒斥","emotion":"强烈","group_id":8,"group_tone":"annoyed scolding","group_tone_cn":"厌烦地斥责"},{"id":16,"start":"00:00:21,040","end":"00:00:21,920","speaker":"王琳","text":"你这样会让我很累","tone":"推卸责任的抱怨","emotion":"强烈","group_id":9,"group_tone":"whining and blaming","group_tone_cn":"抱怨着推卸责任"},{"id":17,"start":"00:00:21,960","end":"00:00:22,720","speaker":"王琳","text":"你能不能别像","tone":"嫌弃的口吻","emotion":"强烈","group_id":10,"group_tone":"condescending accusation","group_tone_cn":"居高临下地指责"},{"id":18,"start":"00:00:22,720","end":"00:00:24,160","speaker":"王琳","text":"小孩子一样耍小脾气了","tone":"充满优越感的指责","emotion":"强烈","group_id":10,"group_tone":"condescending accusation","group_tone_cn":"居高临下地指责"},{"id":19,"start":"00:00:24,840","end":"00:00:25,520","speaker":"陈凡","text":"我没有闹","tone":"沉静地反驳","emotion":"轻微","group_id":11,"group_tone":"calm rebuttal","group_tone_cn":"冷静地反驳"},{"id":20,"start":"00:00:26,560","end":"00:00:27,520","speaker":"陈凡","text":"你不用跟我解释的","tone":"看穿后的冷淡","emotion":"中等","group_id":12,"group_tone":"cold and indifferent","group_tone_cn":"冷漠而无动于衷"},{"id":21,"start":"00:00:30,640","end":"00:00:30,920","speaker":"王琳","text":"给","tone":"随意的给予","emotion":"平淡","group_id":13,"group_tone":"casual and perfunctory","group_tone_cn":"随意敷衍"},{"id":22,"start":"00:00:31,720","end":"00:00:32,440","speaker":"王琳","text":"纪念日礼物","tone":"例行公事般的敷衍","emotion":"平淡","group_id":13,"group_tone":"casual and perfunctory","group_tone_cn":"随意敷衍"},{"id":23,"start":"00:00:39,280","end":"00:00:39,760","speaker":"陈凡(内心独白)","text":"她说","tone":"低沉的旁白感","emotion":"轻微","group_id":14,"group_tone":"bitter, hollow, heartbroken whisper","group_tone_cn":"苦涩空洞、心碎的低语"},{"id":24,"start":"00:00:40,280","end":"00:00:41,040","speaker":"陈凡(内心独白)","text":"只要我想","tone":"平静中带着苦涩","emotion":"中等","group_id":14,"group_tone":"bitter, hollow, heartbroken whisper","group_tone_cn":"苦涩空洞、心碎的低语"},{"id":25,"start":"00:00:41,560","end":"00:00:42,000","speaker":"陈凡(内心独白)","text":"她就可以","tone":"讽刺的心理重复","emotion":"中等","group_id":14,"group_tone":"bitter, hollow, heartbroken whisper","group_tone_cn":"苦涩空洞、心碎的低语"},{"id":26,"start":"00:00:42,000","end":"00:00:43,040","speaker":"陈凡(内心独白)","text":"抛下一切来陪我","tone":"极度心碎后的麻木","emotion":"强烈","group_id":14,"group_tone":"bitter, hollow, heartbroken whisper","group_tone_cn":"苦涩空洞、心碎的低语"},{"id":27,"start":"00:00:47,400","end":"00:00:48,880","speaker":"陈凡","text":"这是送给赵斌的礼物","tone":"平静地揭穿谎言","emotion":"强烈","group_id":15,"group_tone":"calmly sarcastic, disillusioned","group_tone_cn":"平静地讽刺，不再抱有幻想"},{"id":28,"start":"00:00:48,880","end":"00:00:50,120","speaker":"陈凡","text":"附带的赠品吧","tone":"带着一丝自嘲的讽刺","emotion":"强烈","group_id":15,"group_tone":"calmly sarcastic, disillusioned","group_tone_cn":"平静地讽刺，不再抱有幻想"},{"id":29,"start":"00:00:52,240","end":"00:00:52,680","speaker":"陈凡","text":"谢谢","tone":"礼貌而疏离的道谢","emotion":"轻微","group_id":16,"group_tone":"polite, distant","group_tone_cn":"礼貌而疏离"},{"id":30,"start":"00:00:54,680","end":"00:00:55,480","speaker":"陈凡","text":"谢谢","tone":"再次强调，带有决绝感","emotion":"中等","group_id":17,"group_tone":"firm, final","group_tone_cn":"坚定而决绝"},{"id":31,"start":"00:00:56,160","end":"00:00:56,680","speaker":"王琳","text":"然后呢","tone":"感到冒犯的询问","emotion":"中等","group_id":18,"group_tone":"questioning with dissatisfaction","group_tone_cn":"不满地质问"},{"id":32,"start":"00:00:56,960","end":"00:00:57,440","speaker":"王琳","text":"就没了","tone":"期待更多回应的不满","emotion":"中等","group_id":18,"group_tone":"questioning with dissatisfaction","group_tone_cn":"不满地质问"},{"id":33,"start":"00:00:58,840","end":"00:00:59,240","speaker":"陈凡","text":"没了","tone":"冷淡地收尾","emotion":"平淡","group_id":19,"group_tone":"curt and cold","group_tone_cn":"简短冷淡"},{"id":34,"start":"00:01:00,520","end":"00:01:01,200","speaker":"王琳","text":"我的礼物呢","tone":"理直气壮的讨要","emotion":"强烈","group_id":20,"group_tone":"demanding, entitled","group_tone_cn":"理直气壮地索要"},{"id":35,"start":"00:01:03,960","end":"00:01:04,560","speaker":"陈凡","text":"不好意思啊","tone":"毫无歉意的敷衍","emotion":"轻微","group_id":21,"group_tone":"dismissive, indifferent","group_tone_cn":"敷衍冷漠"},{"id":36,"start":"00:01:04,960","end":"00:01:05,480","speaker":"陈凡","text":"我忘了","tone":"干脆利落的承认","emotion":"平淡","group_id":21,"group_tone":"dismissive, indifferent","group_tone_cn":"敷衍冷漠"},{"id":37,"start":"00:01:05,920","end":"00:01:06,960","speaker":"陈凡","text":"我给你钱你自己买吧","tone":"用金钱打发的冷酷","emotion":"中等","group_id":21,"group_tone":"dismissive, indifferent","group_tone_cn":"敷衍冷漠"},{"id":38,"start":"00:01:07,640","end":"00:01:08,760","speaker":"王琳","text":"你竟然忘了","tone":"感到被轻视的愤怒","emotion":"强烈","group_id":22,"group_tone":"angry, threatening","group_tone_cn":"愤怒地威胁"},{"id":39,"start":"00:01:09,240","end":"00:01:09,880","speaker":"王琳","text":"陈凡","tone":"严厉的警告","emotion":"强烈","group_id":22,"group_tone":"angry, threatening","group_tone_cn":"愤怒地威胁"},{"id":40,"start":"00:01:10,240","end":"00:01:11,160","speaker":"王琳","text":"我生气了","tone":"惯用的威胁口吻","emotion":"强烈","group_id":22,"group_tone":"angry, threatening","group_tone_cn":"愤怒地威胁"},{"id":41,"start":"00:01:12,240","end":"00:01:13,240","speaker":"王琳","text":"就算你给我转","tone":"预设对方会讨好","emotion":"中等","group_id":23,"group_tone":"haughty refusal","group_tone_cn":"傲慢地拒绝"},{"id":42,"start":"00:01:13,240","end":"00:01:14,520","speaker":"王琳","text":"一三一四也没有用","tone":"摆高姿态的拒绝","emotion":"中等","group_id":23,"group_tone":"haughty refusal","group_tone_cn":"傲慢地拒绝"},{"id":43,"start":"00:01:15,200","end":"00:01:16,520","speaker":"王琳","text":"每年交换纪念日礼物","tone":"强调曾经的规则","emotion":"中等","group_id":24,"group_tone":"accusatory, demanding","group_tone_cn":"咄咄逼人地质问"},{"id":44,"start":"00:01:16,680","end":"00:01:17,800","speaker":"王琳","text":"不是我们的约定吗","tone":"咄咄逼人的质问","emotion":"中等","group_id":24,"group_tone":"accusatory, demanding","group_tone_cn":"咄咄逼人地质问"},{"id":45,"start":"00:01:18,640","end":"00:01:19,080","speaker":"陈凡","text":"是啊","tone":"沉稳地回应，带有转折感","emotion":"中等","group_id":25,"group_tone":"agreeing with reservation","group_tone_cn":"有所保留地同意"},{"id":46,"start":"00:01:20,400","end":"00:01:21,320","speaker":"陈凡","text":"这么多年","tone":"感怀而坚定的陈述","emotion":"中等","group_id":26,"group_tone":"reflective, earnest","group_tone_cn":"感慨而真挚"},{"id":47,"start":"00:01:21,680","end":"00:01:22,840","speaker":"陈凡","text":"我一直都在坚持","tone":"强调自己的付出","emotion":"中等","group_id":26,"group_tone":"reflective, earnest","group_tone_cn":"感慨而真挚"},{"id":48,"start":"00:01:23,480","end":"00:01:24,040","speaker":"陈凡","text":"也许","tone":"深思熟虑后的停顿","emotion":"中等","group_id":27,"group_tone":"determined, resolute","group_tone_cn":"下定决心，坚定"},{"id":49,"start":"00:01:24,800","end":"00:01:25,880","speaker":"陈凡","text":"今天也该改变了","tone":"下定决心的宣告","emotion":"强烈","group_id":27,"group_tone":"determined, resolute","group_tone_cn":"下定决心，坚定"},{"id":50,"start":"00:01:29,040","end":"00:01:29,800","speaker":"王琳","text":"你去哪啊","tone":"意外且狐疑的询问","emotion":"中等","group_id":28,"group_tone":"surprised, suspicious","group_tone_cn":"惊讶而怀疑"},{"id":51,"start":"00:01:30,440","end":"00:01:31,440","speaker":"陈凡","text":"和朋友出去喝酒","tone":"坦荡而坚决的回答","emotion":"中等","group_id":29,"group_tone":"frank and firm","group_tone_cn":"坦率而坚定"},{"id":52,"start":"00:01:32,120","end":"00:01:32,640","speaker":"王琳","text":"喝酒","tone":"不可思议的重复","emotion":"强烈","group_id":30,"group_tone":"incredulous","group_tone_cn":"难以置信"},{"id":53,"start":"00:01:34,520","end":"00:01:35,000","speaker":"王琳","text":"我不说过","tone":"高压态势的提醒","emotion":"强烈","group_id":31,"group_tone":"controlling, interrogating","group_tone_cn":"控制欲极强地反问"},{"id":54,"start":"00:01:35,000","end":"00:01:36,000","speaker":"王琳","text":"我不喜欢你喝酒的吗","tone":"控制欲极强的质问","emotion":"强烈","group_id":31,"group_tone":"controlling, interrogating","group_tone_cn":"控制欲极强地反问"},{"id":55,"start":"00:01:37,240","end":"00:01:37,640","speaker":"陈凡","text":"是啊","tone":"正面的对峙","emotion":"中等","group_id":32,"group_tone":"confrontational agreement","group_tone_cn":"对峙般的同意"},{"id":56,"start":"00:01:38,400","end":"00:01:39,960","speaker":"陈凡","text":"因为你的一句不喜欢","tone":"陈述过往的妥协","emotion":"中等","group_id":33,"group_tone":"bitterly stating facts","group_tone_cn":"苦涩地陈述事实"},{"id":57,"start":"00:01:40,240","end":"00:01:41,120","speaker":"陈凡","text":"我把酒戒了","tone":"强调曾经的牺牲","emotion":"中等","group_id":33,"group_tone":"bitterly stating facts","group_tone_cn":"苦涩地陈述事实"},{"id":58,"start":"00:01:41,800","end":"00:01:42,600","speaker":"陈凡","text":"但现在","tone":"强有力的转折","emotion":"强烈","group_id":34,"group_tone":"determined, hopeful","group_tone_cn":"坚定而充满希望"},{"id":59,"start":"00:01:43,160","end":"00:01:43,640","speaker":"陈凡","text":"我想找回","tone":"寻求自我的渴望","emotion":"强烈","group_id":34,"group_tone":"determined, hopeful","group_tone_cn":"坚定而充满希望"},{"id":60,"start":"00:01:43,640","end":"00:01:44,840","speaker":"陈凡","text":"属于自己的生活","tone":"坚定的人生宣言","emotion":"强烈","group_id":34,"group_tone":"determined, hopeful","group_tone_cn":"坚定而充满希望"},{"id":61,"start":"00:01:45,720","end":"00:01:46,440","speaker":"王琳","text":"你不许去","tone":"命令式的阻拦","emotion":"强烈","group_id":35,"group_tone":"authoritative, forbidding","group_tone_cn":"命令式禁止"},{"id":62,"start":"00:01:47,040","end":"00:01:48,120","speaker":"王琳","text":"陈凡我说你别去","tone":"歇斯底里的制止","emotion":"强烈","group_id":36,"group_tone":"hysterical, pleading","group_tone_cn":"歇斯底里地制止"},{"id":63,"start":"00:01:48,120","end":"00:01:48,880","speaker":"王琳","text":"你听到没有","tone":"愤怒的吼叫","emotion":"强烈","group_id":37,"group_tone":"angry, demanding","group_tone_cn":"愤怒地要求回应"},{"id":64,"start":"00:01:48,960","end":"00:01:50,080","speaker":"王琳","text":"陈凡我生气了","tone":"无计可施后的暴怒","emotion":"强烈","group_id":38,"group_tone":"enraged, threatening","group_tone_cn":"暴怒地威胁"},{"id":65,"start":"00:01:55,040","end":"00:01:55,800","speaker":"王琳","text":"这还差不多","tone":"自以为是的胜利感","emotion":"中等","group_id":39,"group_tone":"smugly satisfied","group_tone_cn":"得意地满足"},{"id":66,"start":"00:01:56,520","end":"00:01:57,480","speaker":"王琳","text":"和你那些狐朋狗友","tone":"尖酸刻薄的贬低","emotion":"中等","group_id":40,"group_tone":"scornful, dismissive","group_tone_cn":"轻蔑地嘲讽"},{"id":67,"start":"00:01:57,480","end":"00:01:58,480","speaker":"王琳","text":"有什么好喝酒的","tone":"满脸不屑的嘲讽","emotion":"中等","group_id":40,"group_tone":"scornful, dismissive","group_tone_cn":"轻蔑地嘲讽"},{"id":68,"start":"00:01:58,840","end":"00:01:59,800","speaker":"王琳","text":"赶紧给我做饭去","tone":"颐指气使的命令","emotion":"强烈","group_id":41,"group_tone":"bossy, ordering","group_tone_cn":"颐指气使地命令"},{"id":69,"start":"00:02:01,320","end":"00:02:03,360","speaker":"陈凡","text":"我朋友都知道你管的严","tone":"冷淡地指出事实","emotion":"中等","group_id":42,"group_tone":"coldly stating facts","group_tone_cn":"冷淡地陈述事实"},{"id":70,"start":"00:02:04,160","end":"00:02:05,560","speaker":"陈凡","text":"所以喝酒从来都不叫我","tone":"揭示由于对方造成的社交孤立","emotion":"中等","group_id":42,"group_tone":"coldly stating facts","group_tone_cn":"冷淡地陈述事实"},{"id":71,"start":"00:02:06,520","end":"00:02:07,440","speaker":"陈凡","text":"但今后","tone":"平静的预告","emotion":"强烈","group_id":43,"group_tone":"calmly decisive","group_tone_cn":"冷静而果断"},{"id":72,"start":"00:02:08,080","end":"00:02:08,640","speaker":"陈凡","text":"不会了","tone":"斩钉截铁的了断","emotion":"强烈","group_id":43,"group_tone":"calmly decisive","group_tone_cn":"冷静而果断"},{"id":73,"sta